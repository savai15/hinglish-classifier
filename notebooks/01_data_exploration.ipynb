import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
import os

# Load the Hinglish dataset
df = pd.read_csv("data/raw/hinglish_ecommerce_complaints_360_spelling_variants.csv")

print("Dataset Information:")
print("=" * 50)
print(f"Shape: {df.shape}")
print(f"\nColumns: {df.columns.tolist()}")

print("\nData Sample:")
df.head()

print("\nData Description:")
df.describe(include=["object"])

print("\nMissing Values:")
print(df.isnull().sum())

# Category distribution
print("\nCategory Distribution:")
category_counts = df['category'].value_counts()
print(category_counts)

print(f"\nTotal Categories: {len(df['category'].unique())}")

# Urgency distribution
print("\nUrgency Distribution:")
urgency_counts = df['urgency'].value_counts()
print(urgency_counts)

print(f"\nTotal Urgency Levels: {len(df['urgency'].unique())}")

# Text length analysis
print("\nText Statistics:")
df['text_length'] = df['text'].apply(len)
df['word_count'] = df['text'].apply(lambda x: len(x.split()))

print(df[['text_length', 'word_count']].describe())

# Create visualizations
fig, axes = plt.subplots(1, 2, figsize=(14, 5))

# Category distribution
axes[0].barh(category_counts.index, category_counts.values)
axes[0].set_title('Complaint Categories Distribution', fontsize=14)
axes[0].set_xlabel('Count', fontsize=12)

# Urgency distribution
urgency_counts_sorted = urgency_counts.reindex(['Low', 'Medium', 'High'])
axes[1].bar(urgency_counts_sorted.index, urgency_counts_sorted.values, color=['green', 'orange', 'red'])
axes[1].set_title('Urgency Level Distribution', fontsize=14)
axes[1].set_ylabel('Count', fontsize=12)

plt.tight_layout()
plt.savefig('reports/initial_analysis.png', dpi=150, bbox_inches='tight')
plt.show()

# Display key insights
print("\nKEY INSIGHTS:")
print("=" * 50)
print(f"• Dataset contains {len(df):,} Hinglish customer complaints")
print(f"• {len(category_counts)} unique categories")
print(f"• {len(urgency_counts)} urgency levels (Low, Medium, High)")
print(f"• Average text length: {df['text_length'].mean():.0f} characters")
print(f"• Average word count: {df['word_count'].mean():.0f} words")

print("\nCategory Distribution:")
for i, (cat, count) in enumerate(category_counts.items(), 1):
    percentage = (count / len(df)) * 100
    print(f"  {i}. {cat}: {count:,} ({percentage:.1f}%)")

print("\nUrgency Distribution:")
for i, (urgency, count) in enumerate(urgency_counts.items(), 1):
    percentage = (count / len(df)) * 100
    print(f"  {i}. {urgency}: {count:,} ({percentage:.1f}%)")

print(f"\nDataset is ready for preprocessing and model training!")